# Environment Variables Template
# Copy this to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ===== SALESFORCE COMMERCE STOREFRONT API =====
# Instance URL of your Salesforce org
# SALESFORCE_INSTANCE_URL=https://orgfarm-e6b615be40-dev-ed.develop.my.salesforce.com

# # Salesforce API Version (default: v60.0)
# SALESFORCE_API_VERSION=v60.0

# # Salesforce B2B Commerce Web Store ID (001xx...)
# # Find via: Setup > Stores > Your Store > Store ID
# SALESFORCE_WEBSTORE_ID=0ZEdL000002gy8HWAQ

# # Salesforce Effective Account ID (001xx...)
# # The buyer account ID for cart/search context
# # Find via: Setup > Accounts > Your Account > Account ID
# SALESFORCE_EFFECTIVE_ACCOUNT_ID=001dL00001jFm6lQAC

# ===== AUTHENTICATION (JWT BEARER FLOW - TO BE IMPLEMENTED) =====
# These will be used when JWT Bearer Flow is wired up
# For now: Leave commented or use placeholder

# Connected App Client ID (from Setup > Apps > App Manager)
# SALESFORCE_CLIENT_ID=3MVG9GCMQoQ6rpzR2MfU...

# Integration User Username (service account email)
# SALESFORCE_USERNAME=integration@company.com

# Connected App Private Key (PEM format)
# SALESFORCE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# OAuth Login URL
# SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ===== AUTHENTICATION STUB (FOR TESTING) =====
# Temporary: Use this to test without JWT implementation
# Generate a real access token manually and paste here for testing
# SALESFORCE_ACCESS_TOKEN_STUB=your_temp_access_token_here
# ===== SALESFORCE COMMERCE STOREFRONT API =====
# Provide your Salesforce instance URL (do NOT commit real values)
SALESFORCE_INSTANCE_URL=https://orgfarm-e6b615be40-dev-ed.develop.my.salesforce.com
# Salesforce API Version (default: v60.0)
SALESFORCE_API_VERSION=v60.0
# Salesforce B2B Commerce Web Store ID (e.g. 0ZExxx...)
SALESFORCE_WEBSTORE_ID=0ZEdL000002gy8HWAQ
# Salesforce Effective Account ID (e.g. 001xxx...)
SALESFORCE_EFFECTIVE_ACCOUNT_ID=001dL00001jFm6lQAC

# ===== AUTHENTICATION STUB (FOR TESTING ONLY) =====
# For security, do NOT include real tokens in this template. Copy this file
# to .env.local and set `SALESFORCE_ACCESS_TOKEN_STUB` there for local testing
# if needed. Do NOT commit .env.local.
# SALESFORCE_ACCESS_TOKEN_STUB=your_temp_access_token_here
